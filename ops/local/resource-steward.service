# Шаблон systemd user-service для фабричного сторожа диска и RAM.
# УСТАНОВКА В ЖИВУЮ СИСТЕМУ — ТОЛЬКО ВЛАДЕЛЬЦЕМ И ВРУЧНУЮ (см. RESOURCE-STEWARD.md).
# Во время испытаний фабрики юниты не устанавливать: правь пути под свой чекаут.

[Unit]
Description=Darkfactory resource steward (Tier-1 disk/RAM cleanup)

[Service]
Type=oneshot
# DF_NODE (Node >= 22.18) и DF_REPO — абсолютные пути из операторской настройки.
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/darkfactory/resource-steward.env
ExecStart=/usr/bin/env "${DF_NODE}" "${DF_REPO}/board_pipeline/resource-steward.mjs" --journal %h/.local/state/resource-steward/journal.jsonl
# Сторож обязан видеть НАСТОЯЩИЙ /tmp: PrivateTmp спрятал бы записи df-*.
PrivateTmp=false
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Дефис перед путём = путь может не существовать, юнит не падает.
ReadWritePaths=/tmp -%h/.cache -%h/.npm -%h/.local/state/resource-steward
Nice=10
IOSchedulingClass=idle
