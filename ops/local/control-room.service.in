# systemd user-unit для Control Room Aggregator (V2-3).
# Шаблон: подставьте @NODE@, @REPO@, @BOARD@, @STATEDIR@.
# Установка — только явной командой оператора; сборка/тесты юнит НЕ
# активируют. Слушает строго 127.0.0.1:44110 (доступ — локально или
# ssh -L 44110:127.0.0.1:44110).
[Unit]
Description=Darkfactory control room aggregator (read-only)
After=default.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NODE@ @REPO@/ops/control-room/aggregator.mjs --port 44110 --board-url @BOARD@ --state-dir @STATEDIR@ --drift-repo @REPO@ --cloud-state @STATEDIR@/cloud-worker-state.json --worker-usage @STATEDIR@/cloud-worker-usage.json
# Read-only пульт: нет сетевого egress кроме Board, нет записи в worktree.
Restart=on-failure
RestartSec=10
MemoryMax=512M
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
